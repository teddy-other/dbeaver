<plugin>
    <extension point="org.jkiss.dbeaver.dataSourceProvider">
        <datasource
            class="org.jkiss.dbeaver.ext.coradb.CoraDbDataSourceProvider"
            description="CoraDB JDBC Driver"
            icon="icons/coradb_icon.png"
            id="coradb"
            parent="generic"
            label="coradb jdbc"
            dialect="coradb">
            <tree path="coradb" label="CoraDB data source" supportsEntityMerge="true">
            	<folder id="schemas" type="org.jkiss.dbeaver.ext.coradb.model.CoradbUser" label="%tree.schemas.node.name"
                        icon="#folder_schema" description="%tree.schemas.node.tip">
                    <items label="%tree.user.node.name" path="coradbUser" property="coradbUsers" icon="#schema">
	                    <folder type="org.jkiss.dbeaver.ext.coradb.model.CoraDbVertex" label="%tree.table.node.name" icon="#folder_table" description="%tree.tables.node.name">
		                  <items label="%tree.table.node.name" path="vertex" property="vertexs" icon="#table">
		                    <folder type="org.jkiss.dbeaver.ext.coradb.model.CoraDbVertexColumn" label="%tree.column.node.name" icon="#columns" description="%tree.columns.node.tip">
		                        <items label="%tree.column.node.name" path="nodeproperties" property="attributes" icon="#column">
		                        </items>
		                    </folder>
		                  </items>
	                    </folder>
	                    <folder type="org.jkiss.dbeaver.ext.coradb.model.CoraDbEdge" label="%tree.table.edge.name" icon="#folder_view" description="%tree.table.edge.name">
	                      <items label="%tree.table.edge.name" path="edge" property="edges" icon="#view">
	                        <folder type="org.jkiss.dbeaver.ext.coradb.model.CoraDbEdgeColumn" label="%tree.column.edge.name" icon="#columns" description="%tree.column.edge.tip">
	                          <items label="%tree.column.node.name" path="edgeproperties" property="attributes" icon="#column">
	                          </items>
	                        </folder>
	                      </items>
	                    </folder>
					</items>
				</folder>
            </tree>
            <drivers managable="true">
                    <driver
                        id="coradb_jdbc"
                        label="CORADB"
                        icon="icons/coradb_icon.png"
                        iconBig="icons/coradb_icon_big.png"
                        class="coradb.jdbc.driver.CORADBDriver"
                        sampleURL="jdbc:coradb:{host}:{port}:{database}:::"
                        defaultPort="30000"
                        description="CORADB JDBC driver"
                        supportedConfigurationTypes="MANUAL,URL"
                        webURL="https://www.coradb.ai/"
                        categories="sql">
                        <file type="jar" path="https://ftp.cubrid.org/iitp/coradb/jdbc/JDBC-1.0.0.1581-coradb.jar"/>
                        <parameter name="stored-unquoted-case" value="UPPER"/>
	                    <property name="altHosts" value=""/>
	                    <property name="rcTime" value="600"/>
	                    <property name="loadBalance" value="false"/>
	                    <property name="connectTimeout" value="30"/>
	                    <property name="queryTimeout" value="0"/>
	                    <property name="charset" value="utf-8"/>
	                    <property name="zeroDateTimeBehavior" value="exception"/>
	                    <property name="logFile" value="cubrid_jdbc.log"/>
	                    <property name="logOnException" value="false"/>
	                    <property name="logSlowQueries" value="false"/>
	                    <property name="slowQueryThresholdMillis" value="60000"/>
	                    <property name="useLazyConnection" value="false"/>
	                    <property name="useSSL" value="false"/>
	                    <property name="clientCacheSize" value="1"/>
	                    <property name="usePreparedStmtCache" value="false"/>
	                    <property name="preparedStmtCacheSize" value="25"/>
	                    <property name="preparedStmtCacheSqlLimit" value="256"/>
	                    <property name="hold_cursor" value="true"/>
	                    <property name="@dbeaver-default-resultset.maxrows.sql" value="true"/>
                    </driver>
	                <driver
    	                categories="graph"
        	            class="org.neo4j.jdbc.Driver"
            	        defaultPort="7687"
                	    defaultDatabase="neo4j"
	                    defaultUser="neo4j"
    	                description="Neo4j JDBC driver"
                    	icon="icons/neo4j_icon.png"
                    	iconBig="icons/neo4j_icon_big.png"
                    	id="vit_neo4j_jdbc"
                    	label="Neo4j Graph"
                    	promoted="1"
                    	sampleURL="jdbc:neo4j:bolt://{host}[:{port}]/?database={database}"
                    	webURL="https://github.com/neo4j-contrib/neo4j-jdbc">
                    	<file
                        path="maven:/org.neo4j:neo4j-jdbc-driver:RELEASE"
                        type="jar">
                    	</file>
                    	<parameter
                        	name="supports-truncate"
                        	value="false">
                    	<parameter 
                        	name="stored-unquoted-case" 
                        	value="UPPER"/>
                    	</parameter>
                    <property name="@dbeaver-default-sql.parameter.enabled" value="false"/>
                </driver>
            </drivers>
        </datasource>
    </extension>

    <extension point="org.jkiss.dbeaver.sqlDialect">
        <dialect id="coradb" parent="basic" class="org.jkiss.dbeaver.ext.coradb.model.CoraDbDialect" label="CoraDB" description="CoraDB dialect." icon="coradb_icon.png">
        </dialect>
    </extension>

	<extension point="org.jkiss.dbeaver.mavenRepository">
        <repository id="cubrid-turbograph-maven-repo" name="turbograph Repository" url="https://ftp.cubrid.org/iitp/maven">
            <scope group="turbograph"/>
        </repository>
    </extension>

    <extension point="org.jkiss.dbeaver.objectManager">
        <manager class="org.jkiss.dbeaver.ext.coradb.edit.CoraDbVertexManager"         objectType="org.jkiss.dbeaver.ext.coradb.model.CoraDbVertex"/>
        <manager class="org.jkiss.dbeaver.ext.coradb.edit.CoraDbEdgeManager"          objectType="org.jkiss.dbeaver.ext.coradb.model.CoraDbEdge"/>
        <manager class="org.jkiss.dbeaver.ext.coradb.edit.CoraDbVertexColumnManager"   objectType="org.jkiss.dbeaver.ext.coradb.model.CoraDbVertexColumn"/>
        <manager class="org.jkiss.dbeaver.ext.coradb.edit.CoraDbEdgeManager"          objectType="org.jkiss.dbeaver.ext.coradb.model.Neo4jEdge"/>
        <manager class="org.jkiss.dbeaver.ext.coradb.edit.CoraDbVertexColumnManager"   objectType="org.jkiss.dbeaver.ext.coradb.model.Neo4jProperty"/>
    </extension>
</plugin>
