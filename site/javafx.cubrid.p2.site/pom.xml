<?xml version="1.0" encoding="UTF-8"?>
<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.cubrid.cubridmanager</groupId>
    <artifactId>p2-site</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>JavaFX local p2 site (reficio) — TurboGraphPP FXGraph</name>
    <description>
        Physical p2 update site under target/repository/ (plugins + content.xml + artifacts.xml).
        OpenJFX 23.0.2 base/controls/graphics per OS classifier plus at.bestsolution.openjfx:javafx-swt (BestSolution Maven).
        Bundle-SymbolicName in instructions must omit the Maven classifier suffix: reficio appends ".{classifier}"
        (see P2Helper bug28), so e.g. openjfx.controls + win → openjfx.controls.win (not openjfx.controls.win32_64.win).
        p2.index is copied into the repo after the site is built.
        reficio ships old bnd: use _noee (not -noee) and JavaSE-17 in manifest/p2 to avoid osgi.ee=UNKNOWN; product runtime still needs JDK 21 for OpenJFX 23.
        OSGi wiring: openjfx.controls exports com.sun.javafx.*; openjfx.graphics imports/DynamicImport for StyleManager/modena.css (Utils CNFE fix).
        Run: mvn clean package
    </description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <javafx.version>23.0.2</javafx.version>
        <reficio.p2.version>2.1.0</reficio.p2.version>
    </properties>

    <repositories>
        <repository>
            <id>bestsolution-releases</id>
            <url>https://maven.bestsolution.at/repos/releases/</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>

    <build>
        <plugins>
            <plugin>
                <groupId>org.reficio</groupId>
                <artifactId>p2-maven-plugin</artifactId>
                <version>${reficio.p2.version}</version>
                <executions>
                    <execution>
                        <id>openjfx-p2-site</id>
                        <phase>package</phase>
                        <goals>
                            <goal>site</goal>
                        </goals>
                        <configuration>
                            <destinationDirectory>${project.build.directory}/repository</destinationDirectory>
                            <compressSite>false</compressSite>
                            <artifacts>
                        <!-- javafx-base -->
                        <artifact>
                            <id>org.openjfx:javafx-base:jar:win:${javafx.version}</id>
                            <transitive>false</transitive>
                            <override>true</override>
                            <instructions>
                                <Bundle-SymbolicName>openjfx.base</Bundle-SymbolicName>
                                <Bundle-Version>${javafx.version}</Bundle-Version>
                                <_noee>true</_noee>
                                <Require-Capability>osgi.ee;filter:="(&amp;(osgi.ee=JavaSE)(version=17))"</Require-Capability>
                                <Bundle-RequiredExecutionEnvironment>JavaSE-17</Bundle-RequiredExecutionEnvironment>
                            </instructions>
                        </artifact>
                        <artifact>
                            <id>org.openjfx:javafx-base:jar:linux:${javafx.version}</id>
                            <transitive>false</transitive>
                            <override>true</override>
                            <instructions>
                                <Bundle-SymbolicName>openjfx.base</Bundle-SymbolicName>
                                <Bundle-Version>${javafx.version}</Bundle-Version>
                                <_noee>true</_noee>
                                <Require-Capability>osgi.ee;filter:="(&amp;(osgi.ee=JavaSE)(version=17))"</Require-Capability>
                                <Bundle-RequiredExecutionEnvironment>JavaSE-17</Bundle-RequiredExecutionEnvironment>
                            </instructions>
                        </artifact>
                        <artifact>
                            <id>org.openjfx:javafx-base:jar:mac:${javafx.version}</id>
                            <transitive>false</transitive>
                            <override>true</override>
                            <instructions>
                                <Bundle-SymbolicName>openjfx.base</Bundle-SymbolicName>
                                <Bundle-Version>${javafx.version}</Bundle-Version>
                                <_noee>true</_noee>
                                <Require-Capability>osgi.ee;filter:="(&amp;(osgi.ee=JavaSE)(version=17))"</Require-Capability>
                                <Bundle-RequiredExecutionEnvironment>JavaSE-17</Bundle-RequiredExecutionEnvironment>
                            </instructions>
                        </artifact>
                        <artifact>
                            <id>org.openjfx:javafx-base:jar:mac-aarch64:${javafx.version}</id>
                            <transitive>false</transitive>
                            <override>true</override>
                            <instructions>
                                <Bundle-SymbolicName>openjfx.base</Bundle-SymbolicName>
                                <Bundle-Version>${javafx.version}</Bundle-Version>
                                <_noee>true</_noee>
                                <Require-Capability>osgi.ee;filter:="(&amp;(osgi.ee=JavaSE)(version=17))"</Require-Capability>
                                <Bundle-RequiredExecutionEnvironment>JavaSE-17</Bundle-RequiredExecutionEnvironment>
                            </instructions>
                        </artifact>
                        <artifact>
                            <id>org.openjfx:javafx-base:jar:linux-aarch64:${javafx.version}</id>
                            <transitive>false</transitive>
                            <override>true</override>
                            <instructions>
                                <Bundle-SymbolicName>openjfx.base</Bundle-SymbolicName>
                                <Bundle-Version>${javafx.version}</Bundle-Version>
                                <_noee>true</_noee>
                                <Require-Capability>osgi.ee;filter:="(&amp;(osgi.ee=JavaSE)(version=17))"</Require-Capability>
                                <Bundle-RequiredExecutionEnvironment>JavaSE-17</Bundle-RequiredExecutionEnvironment>
                            </instructions>
                        </artifact>

                        <!-- javafx-controls -->
                        <artifact>
                            <id>org.openjfx:javafx-controls:jar:win:${javafx.version}</id>
                            <transitive>false</transitive>
                            <override>true</override>
                            <instructions>
                                <Bundle-SymbolicName>openjfx.controls</Bundle-SymbolicName>
                                <Bundle-Version>${javafx.version}</Bundle-Version>
                                <_noee>true</_noee>
                                <Require-Capability>osgi.ee;filter:="(&amp;(osgi.ee=JavaSE)(version=17))"</Require-Capability>
                                <Bundle-RequiredExecutionEnvironment>JavaSE-17</Bundle-RequiredExecutionEnvironment>
                                <Export-Package>javafx.*;version="${javafx.version}",com.sun.javafx.*;version="${javafx.version}"</Export-Package>
                                <Require-Bundle>openjfx.base.win;bundle-version="[${javafx.version},24)",openjfx.graphics.win;bundle-version="[${javafx.version},24)"</Require-Bundle>
                            </instructions>
                        </artifact>
                        <artifact>
                            <id>org.openjfx:javafx-controls:jar:linux:${javafx.version}</id>
                            <transitive>false</transitive>
                            <override>true</override>
                            <instructions>
                                <Bundle-SymbolicName>openjfx.controls</Bundle-SymbolicName>
                                <Bundle-Version>${javafx.version}</Bundle-Version>
                                <_noee>true</_noee>
                                <Require-Capability>osgi.ee;filter:="(&amp;(osgi.ee=JavaSE)(version=17))"</Require-Capability>
                                <Bundle-RequiredExecutionEnvironment>JavaSE-17</Bundle-RequiredExecutionEnvironment>
                                <Export-Package>javafx.*;version="${javafx.version}",com.sun.javafx.*;version="${javafx.version}"</Export-Package>
                                <Require-Bundle>openjfx.base.linux;bundle-version="[${javafx.version},24)",openjfx.graphics.linux;bundle-version="[${javafx.version},24)"</Require-Bundle>
                            </instructions>
                        </artifact>
                        <artifact>
                            <id>org.openjfx:javafx-controls:jar:mac:${javafx.version}</id>
                            <transitive>false</transitive>
                            <override>true</override>
                            <instructions>
                                <Bundle-SymbolicName>openjfx.controls</Bundle-SymbolicName>
                                <Bundle-Version>${javafx.version}</Bundle-Version>
                                <_noee>true</_noee>
                                <Require-Capability>osgi.ee;filter:="(&amp;(osgi.ee=JavaSE)(version=17))"</Require-Capability>
                                <Bundle-RequiredExecutionEnvironment>JavaSE-17</Bundle-RequiredExecutionEnvironment>
                                <Export-Package>javafx.*;version="${javafx.version}",com.sun.javafx.*;version="${javafx.version}"</Export-Package>
                                <Require-Bundle>openjfx.base.mac;bundle-version="[${javafx.version},24)",openjfx.graphics.mac;bundle-version="[${javafx.version},24)"</Require-Bundle>
                            </instructions>
                        </artifact>
                        <artifact>
                            <id>org.openjfx:javafx-controls:jar:mac-aarch64:${javafx.version}</id>
                            <transitive>false</transitive>
                            <override>true</override>
                            <instructions>
                                <Bundle-SymbolicName>openjfx.controls</Bundle-SymbolicName>
                                <Bundle-Version>${javafx.version}</Bundle-Version>
                                <_noee>true</_noee>
                                <Require-Capability>osgi.ee;filter:="(&amp;(osgi.ee=JavaSE)(version=17))"</Require-Capability>
                                <Bundle-RequiredExecutionEnvironment>JavaSE-17</Bundle-RequiredExecutionEnvironment>
                                <Export-Package>javafx.*;version="${javafx.version}",com.sun.javafx.*;version="${javafx.version}"</Export-Package>
                                <Require-Bundle>openjfx.base.mac-aarch64;bundle-version="[${javafx.version},24)",openjfx.graphics.mac-aarch64;bundle-version="[${javafx.version},24)"</Require-Bundle>
                            </instructions>
                        </artifact>
                        <artifact>
                            <id>org.openjfx:javafx-controls:jar:linux-aarch64:${javafx.version}</id>
                            <transitive>false</transitive>
                            <override>true</override>
                            <instructions>
                                <Bundle-SymbolicName>openjfx.controls</Bundle-SymbolicName>
                                <Bundle-Version>${javafx.version}</Bundle-Version>
                                <_noee>true</_noee>
                                <Require-Capability>osgi.ee;filter:="(&amp;(osgi.ee=JavaSE)(version=17))"</Require-Capability>
                                <Bundle-RequiredExecutionEnvironment>JavaSE-17</Bundle-RequiredExecutionEnvironment>
                                <Export-Package>javafx.*;version="${javafx.version}",com.sun.javafx.*;version="${javafx.version}"</Export-Package>
                                <Require-Bundle>openjfx.base.linux-aarch64;bundle-version="[${javafx.version},24)",openjfx.graphics.linux-aarch64;bundle-version="[${javafx.version},24)"</Require-Bundle>
                            </instructions>
                        </artifact>

                        <!-- javafx-graphics -->
                        <!-- Eclipse-BuddyPolicy: dependent — graphics searches classloaders of bundles
                             that declare Require-Bundle: openjfx.graphics.win (i.e. openjfx.controls.win).
                             This is resolved at wiring time (no runtime registration step), so there is
                             no timing race with Class.forName("Utils") during Control.<clinit>. -->
                        <artifact>
                            <id>org.openjfx:javafx-graphics:jar:win:${javafx.version}</id>
                            <transitive>false</transitive>
                            <override>true</override>
                            <instructions>
                                <Bundle-SymbolicName>openjfx.graphics</Bundle-SymbolicName>
                                <Bundle-Version>${javafx.version}</Bundle-Version>
                                <_noee>true</_noee>
                                <Require-Capability>osgi.ee;filter:="(&amp;(osgi.ee=JavaSE)(version=17))"</Require-Capability>
                                <Bundle-RequiredExecutionEnvironment>JavaSE-17</Bundle-RequiredExecutionEnvironment>
                                <Eclipse-BuddyPolicy>dependent</Eclipse-BuddyPolicy>
                                <Require-Bundle>openjfx.base.win;bundle-version="[${javafx.version},24)"</Require-Bundle>
                            </instructions>
                        </artifact>
                        <artifact>
                            <id>org.openjfx:javafx-graphics:jar:linux:${javafx.version}</id>
                            <transitive>false</transitive>
                            <override>true</override>
                            <instructions>
                                <Bundle-SymbolicName>openjfx.graphics</Bundle-SymbolicName>
                                <Bundle-Version>${javafx.version}</Bundle-Version>
                                <_noee>true</_noee>
                                <Require-Capability>osgi.ee;filter:="(&amp;(osgi.ee=JavaSE)(version=17))"</Require-Capability>
                                <Bundle-RequiredExecutionEnvironment>JavaSE-17</Bundle-RequiredExecutionEnvironment>
                                <Eclipse-BuddyPolicy>dependent</Eclipse-BuddyPolicy>
                                <Require-Bundle>openjfx.base.linux;bundle-version="[${javafx.version},24)"</Require-Bundle>
                            </instructions>
                        </artifact>
                        <artifact>
                            <id>org.openjfx:javafx-graphics:jar:mac:${javafx.version}</id>
                            <transitive>false</transitive>
                            <override>true</override>
                            <instructions>
                                <Bundle-SymbolicName>openjfx.graphics</Bundle-SymbolicName>
                                <Bundle-Version>${javafx.version}</Bundle-Version>
                                <_noee>true</_noee>
                                <Require-Capability>osgi.ee;filter:="(&amp;(osgi.ee=JavaSE)(version=17))"</Require-Capability>
                                <Bundle-RequiredExecutionEnvironment>JavaSE-17</Bundle-RequiredExecutionEnvironment>
                                <Eclipse-BuddyPolicy>dependent</Eclipse-BuddyPolicy>
                                <Require-Bundle>openjfx.base.mac;bundle-version="[${javafx.version},24)"</Require-Bundle>
                            </instructions>
                        </artifact>
                        <artifact>
                            <id>org.openjfx:javafx-graphics:jar:mac-aarch64:${javafx.version}</id>
                            <transitive>false</transitive>
                            <override>true</override>
                            <instructions>
                                <Bundle-SymbolicName>openjfx.graphics</Bundle-SymbolicName>
                                <Bundle-Version>${javafx.version}</Bundle-Version>
                                <_noee>true</_noee>
                                <Require-Capability>osgi.ee;filter:="(&amp;(osgi.ee=JavaSE)(version=17))"</Require-Capability>
                                <Bundle-RequiredExecutionEnvironment>JavaSE-17</Bundle-RequiredExecutionEnvironment>
                                <Eclipse-BuddyPolicy>dependent</Eclipse-BuddyPolicy>
                                <Require-Bundle>openjfx.base.mac-aarch64;bundle-version="[${javafx.version},24)"</Require-Bundle>
                            </instructions>
                        </artifact>
                        <artifact>
                            <id>org.openjfx:javafx-graphics:jar:linux-aarch64:${javafx.version}</id>
                            <transitive>false</transitive>
                            <override>true</override>
                            <instructions>
                                <Bundle-SymbolicName>openjfx.graphics</Bundle-SymbolicName>
                                <Bundle-Version>${javafx.version}</Bundle-Version>
                                <_noee>true</_noee>
                                <Require-Capability>osgi.ee;filter:="(&amp;(osgi.ee=JavaSE)(version=17))"</Require-Capability>
                                <Bundle-RequiredExecutionEnvironment>JavaSE-17</Bundle-RequiredExecutionEnvironment>
                                <Eclipse-BuddyPolicy>dependent</Eclipse-BuddyPolicy>
                                <Require-Bundle>openjfx.base.linux-aarch64;bundle-version="[${javafx.version},24)"</Require-Bundle>
                            </instructions>
                        </artifact>

                        <!-- JavaFX/SWT (BestSolution); _noee + JavaSE-17 avoids reficio/bnd osgi.ee=UNKNOWN in p2 IU -->
                        <artifact>
                            <id>at.bestsolution.openjfx:javafx-swt:jar:${javafx.version}</id>
                            <transitive>false</transitive>
                            <override>true</override>
                            <instructions>
                                <_noee>true</_noee>
                                <Require-Capability>osgi.ee;filter:="(&amp;(osgi.ee=JavaSE)(version=17))"</Require-Capability>
                                <Bundle-RequiredExecutionEnvironment>JavaSE-17</Bundle-RequiredExecutionEnvironment>
                            </instructions>
                        </artifact>
                    </artifacts>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>copy-p2-index</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/repository</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}</directory>
                                    <includes>
                                        <include>p2.index</include>
                                    </includes>
                                    <filtering>false</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.mortbay.jetty</groupId>
                <artifactId>jetty-maven-plugin</artifactId>
                <version>8.1.5.v20120716</version>
                <configuration>
                    <scanIntervalSeconds>10</scanIntervalSeconds>
                    <webAppSourceDirectory>${project.basedir}/target/repository/</webAppSourceDirectory>
                    <webApp>
                        <contextPath>/site</contextPath>
                    </webApp>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
